---
interface Props {
  title: string;
  activePage: 'home' | 'about';
}

const { title, activePage } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="メインナビゲーション">
        <a href="/" class:list={{ 'is-active': activePage === 'home' }}>ホーム</a>
        <a href="/about/" class:list={{ 'is-active': activePage === 'about' }}>会社概要</a>
      </nav>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <small>&copy; 2026 My Astro App</small>
    </footer>
  </body>
</html>
